# Provider fallback order; use none for retrieval-only mode
LLM_PROVIDER=groq,openai,gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Shared web / Telegram knowledge base
# Generate a private admin key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
BACKEND_URL=http://127.0.0.1:8000
# Create a bot with @BotFather. Never share this token or commit it.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram USER IDs, comma-separated. Usernames and group IDs are not accepted.
TELEGRAM_ADMIN_IDS=

# Persistent chat history. Set mysql to use XAMPP MySQL/MariaDB.
CHAT_DB_BACKEND=sqlite
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_NAME=banking_chat
CHAT_DB_USER=root
CHAT_DB_PASSWORD=

# When set, Atlas stores both conversation history and managed knowledge-base chunks.
# Keep URI private. Otherwise the local SQL/SQLite settings above are used.
MONGODB_URI=
MONGODB_DATABASE=banking_chat
# hybrid = local semantic + keyword search; lexical = low-memory hosted keyword search
RAG_INDEX_BACKEND=hybrid
# polling locally, webhook on Render. Never run both for the same bot.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BACKEND_URL=
